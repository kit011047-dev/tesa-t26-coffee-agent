# systemd service: ให้ pi_server รันเองตอนเปิดเครื่อง และรันใหม่เองถ้าพัง
# pi_setup.sh จะแทน __USER__ ด้วยชื่อผู้ใช้บน Pi ให้อัตโนมัติ
[Unit]
Description=Coffee sensor API (pi_server)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=/home/__USER__/coffee-pi
# เปลี่ยน fake → real เมื่อต่อเซนเซอร์และแก้ read_* เสร็จแล้ว
Environment=SENSOR_MODE=fake
ExecStart=/home/__USER__/coffee-pi/.venv/bin/uvicorn pi_server:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
